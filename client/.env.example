# ===== API CONFIGURATION =====
# Backend API URL (without /api suffix)
VITE_BACKEND_URL=http://localhost:5000

# API Base URL (with /api suffix for fetch calls)
VITE_API_URL=http://localhost:5000/api

# Socket.IO Server URL
VITE_SOCKET_URL=http://localhost:5000

# ===== DEVELOPMENT SETTINGS =====
# Enable/disable console logs in development
VITE_ENABLE_LOGGING=true

# ===== FEATURE FLAGS =====
# Enable/disable features (for gradual rollout)
VITE_ENABLE_IMAGE_UPLOAD=true
VITE_ENABLE_TYPING_INDICATOR=true
VITE_ENABLE_READ_RECEIPTS=true
VITE_ENABLE_FRIEND_REQUESTS=true

# ===== APP CONFIGURATION =====
# App name (used in meta tags)
VITE_APP_NAME=QuickChat

# Default language
VITE_DEFAULT_LANGUAGE=en

# ===== PERFORMANCE SETTINGS =====
# Maximum image upload size in MB
VITE_MAX_IMAGE_SIZE=5

# Message character limit
VITE_MAX_MESSAGE_LENGTH=1000

# ===== TIMEOUT SETTINGS =====
# API request timeout in milliseconds
VITE_API_TIMEOUT=10000

# Socket reconnection attempts
VITE_SOCKET_RECONNECTION_ATTEMPTS=5

# Socket reconnection delay in milliseconds
VITE_SOCKET_RECONNECTION_DELAY=1000